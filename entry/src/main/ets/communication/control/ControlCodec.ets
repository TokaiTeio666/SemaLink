import { AppError, ErrorStage } from '../../common/AppError';
import { DeviceProfileAdvertisement } from '../../contracts/semantic/SemanticModels';
import { ControlEnvelope, ControlMessageType, DataEndpointOffer, TaskCancelControl, ControlClose } from './ControlModels';

export function utf8ByteLength(text: string): number { let n = 0; for (let i = 0; i < text.length; i++) { const c = text.codePointAt(i) ?? 0; n += c <= 0x7f ? 1 : (c <= 0x7ff ? 2 : (c <= 0xffff ? 3 : 4)); if (c > 0xffff) i++; } return n; }
function invalid(message: string): AppError { return new AppError('E_CONTROL_INVALID', message, ErrorStage.PROTOCOL, false); }
function validateProfile(p: DeviceProfileAdvertisement): void { if (p.semanticContractVersion !== '1.0' || typeof p.deviceId !== 'string' || p.deviceId.length === 0 || typeof p.deviceAlias !== 'string' || p.deviceAlias.length === 0 || typeof p.profileVersion !== 'string' || p.profileVersion.length === 0 || typeof p.indexVersion !== 'string' || p.indexVersion.length === 0 || ['NOT_READY','INDEXING','READY'].indexOf(p.indexState) < 0 || !Array.isArray(p.knowledgeDomains) || !Array.isArray(p.modalities) || !Array.isArray(p.retrievalModes) || !Array.isArray(p.supportedLevels) || p.knowledgeDomains.some((x: string) => typeof x !== 'string' || x.length === 0) || p.modalities.some((x: string) => typeof x !== 'string' || x.length === 0) || p.retrievalModes.some((x: string) => typeof x !== 'string' || x.length === 0) || p.supportedLevels.some((x: string) => x !== 'L1' && x !== 'L2') || !Number.isInteger(p.advertisedAtMs) || p.advertisedAtMs <= 0 || !Number.isInteger(p.ttlMs) || p.ttlMs <= 0) throw invalid('profile'); }
function validateOffer(p: DataEndpointOffer): void { if (!/^(?:\d{1,3}\.){3}\d{1,3}$/.test(p.host) || p.host.split('.').some((x: string) => Number(x) > 255) || !Number.isInteger(p.port) || p.port < 1 || p.port > 65535 || typeof p.certificateFingerprint !== 'string' || !/^[0-9a-fA-F]{64}$/.test(p.certificateFingerprint) || typeof p.bindingToken !== 'string' || p.bindingToken.length === 0 || !Number.isInteger(p.endpointVersion) || p.endpointVersion < 1 || !Number.isInteger(p.expiresAtMs) || p.expiresAtMs <= Date.now() || p.dataProtocolVersion !== '2.0') throw invalid('offer'); }
function validatePayload(type: ControlMessageType, payload: Object): void { if (type === 'PROFILE') validateProfile(payload as DeviceProfileAdvertisement); else if (type === 'DATA_ENDPOINT_OFFER') validateOffer(payload as DataEndpointOffer); else if (type === 'TASK_CANCEL') { const p = payload as TaskCancelControl; if (typeof p.taskId !== 'string' || p.taskId.length === 0 || !Array.isArray(p.peerTaskIds) || p.peerTaskIds.some((x: string) => typeof x !== 'string' || x.length === 0) || typeof p.reason !== 'string' || p.reason.length === 0) throw invalid('cancel'); } else { if (typeof (payload as ControlClose).reason !== 'string' || (payload as ControlClose).reason.length === 0) throw invalid('close'); } }
export class ControlCodec {
  encode(envelope: ControlEnvelope): string { this.validate(envelope); const text = JSON.stringify(envelope); if (utf8ByteLength(text) > 1024) throw new AppError('E_CONTROL_FRAME_TOO_LARGE', 'control envelope exceeds limit', ErrorStage.PROTOCOL, false); return text; }
  decode(text: string): ControlEnvelope { if (typeof text !== 'string' || utf8ByteLength(text) > 1024) throw new AppError('E_CONTROL_FRAME_TOO_LARGE', 'control envelope exceeds limit', ErrorStage.PROTOCOL, false); let parsed: Object; try { parsed = JSON.parse(text) as Object; } catch (_) { throw invalid('json'); } if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) throw invalid('json'); this.validate(parsed as ControlEnvelope); return parsed as ControlEnvelope; }
  private validate(e: ControlEnvelope): void { if (e.version !== '1.0' || ['PROFILE','DATA_ENDPOINT_OFFER','TASK_CANCEL','CONTROL_CLOSE'].indexOf(e.type) < 0 || typeof e.messageId !== 'string' || e.messageId.length === 0 || typeof e.deviceId !== 'string' || e.deviceId.length === 0 || !Number.isInteger(e.sentAtMs) || e.sentAtMs <= 0 || typeof e.payload !== 'object' || e.payload === null) throw invalid('envelope'); validatePayload(e.type, e.payload as Object); }
}
